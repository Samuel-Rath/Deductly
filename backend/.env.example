# Tax Deduction Analyzer - Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# CRITICAL SECURITY SETTINGS
# ============================================================================

# Secret key for session management (REQUIRED - minimum 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-minimum-32-characters-required

# Environment (development, staging, production)
ENVIRONMENT=production

# ============================================================================
# CORS & ALLOWED ORIGINS
# ============================================================================

# Comma-separated list of allowed origins (REQUIRED for production)
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# CORS credentials (set to true only if needed)
CORS_ALLOW_CREDENTIALS=false

# CORS cache duration in seconds
CORS_MAX_AGE=600

# ============================================================================
# FILE UPLOAD SECURITY
# ============================================================================

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=10

# Maximum CSV rows to process
MAX_CSV_ROWS=50000

# ============================================================================
# RATE LIMITING
# ============================================================================

# Enable rate limiting
RATE_LIMIT_ENABLED=true

# Requests per minute per IP
RATE_LIMIT_PER_MINUTE=10

# Requests per hour per IP
RATE_LIMIT_PER_HOUR=100

# Upload limit in MB per hour per IP
UPLOAD_RATE_LIMIT_MB_PER_HOUR=100

# ============================================================================
# DATA RETENTION & PRIVACY
# ============================================================================

# Enable ephemeral mode by default (recommended)
EPHEMERAL_MODE=true

# Maximum retention days for persistent mode
MAX_RETENTION_DAYS=30

# Auto cleanup old data
AUTO_CLEANUP_ENABLED=true

# ============================================================================
# DATA REDACTION
# ============================================================================

# Enable automatic redaction of sensitive data
ENABLE_REDACTION=true

# Text to use for redacted content
REDACTION_TEXT=[REDACTED]

# Custom redaction patterns (comma-separated regex patterns)
# Default patterns cover account numbers and BSB codes
REDACTION_PATTERNS=

# ============================================================================
# DATABASE (Optional - only for persistent mode)
# ============================================================================

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./deductions.db

# Echo SQL queries (set to false in production)
DATABASE_ECHO=false

# ============================================================================
# API SECURITY (Optional)
# ============================================================================

# Require API key for all requests
REQUIRE_API_KEY=false

# Comma-separated list of valid API keys
API_KEYS=

# ============================================================================
# TRUSTED PROXIES (For deployment behind reverse proxy)
# ============================================================================

# Comma-separated list of trusted proxy IPs
TRUSTED_PROXIES=

# ============================================================================
# LOGGING & MONITORING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable Swagger UI documentation (disable in production)
ENABLE_SWAGGER_UI=false

# Enable metrics endpoint
ENABLE_METRICS=false

# ============================================================================
# DEPLOYMENT SPECIFIC
# ============================================================================

# Port to run on (default: 8000)
PORT=8000

# Number of worker processes
WORKERS=4

# ============================================================================
# NOTES
# ============================================================================
# 
# Security Best Practices:
# 1. Never commit .env file to version control
# 2. Use strong SECRET_KEY (32+ characters)
# 3. Set specific ALLOWED_ORIGINS in production
# 4. Enable RATE_LIMIT in production
# 5. Keep EPHEMERAL_MODE=true for maximum privacy
# 6. Enable REDACTION in production
# 7. Disable SWAGGER_UI in production
# 8. Use HTTPS only in production
# 9. Regularly rotate SECRET_KEY
# 10. Monitor logs for suspicious activity
#
