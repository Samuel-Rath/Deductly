# Tax Deduction Analyzer - Frontend Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# API CONFIGURATION
# ============================================================================

# Backend API base URL (REQUIRED)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_BASE_URL=https://api.yourdomain.com

# API timeout in milliseconds
VITE_API_TIMEOUT=30000

# ============================================================================
# FILE UPLOAD
# ============================================================================

# Maximum file size in MB (should match backend)
VITE_MAX_FILE_SIZE_MB=10

# ============================================================================
# FEATURES
# ============================================================================

# Enable analytics (set to false for privacy)
VITE_ENABLE_ANALYTICS=false

# Enable error reporting
VITE_ENABLE_ERROR_REPORTING=false

# ============================================================================
# SECURITY
# ============================================================================

# Enable strict mode
VITE_STRICT_MODE=true

# ============================================================================
# DEPLOYMENT
# ============================================================================

# Environment (development, staging, production)
VITE_ENVIRONMENT=production

# App version
VITE_APP_VERSION=1.0.0

# ============================================================================
# NOTES
# ============================================================================
#
# Security Best Practices:
# 1. Never commit .env file to version control
# 2. Use HTTPS for VITE_API_BASE_URL in production
# 3. Keep VITE_ENABLE_ANALYTICS=false for privacy
# 4. Verify VITE_MAX_FILE_SIZE_MB matches backend
# 5. All VITE_ prefixed variables are exposed to client
# 6. Never store secrets in frontend environment variables
#
